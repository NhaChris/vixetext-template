% Adicione seus códigos abaixo:
% Alterando a capa
\renewcommand{\imprimircapa}{%
  \begin{capa}%
    % Todos os elementos da capa devem estar centralizados
        \center
        % Todos os elementos da capa devem estar em negrito
        \bfseries

    \includegraphics[scale=0.12]{imagens/logo-ifs} \\
    \vspace{0.1cm}

        \MakeUppercase{\ABNTEXchapterfont\large\imprimirinstituicao} \\

        \vspace{\onelineskip}

    {\ABNTEXchapterfont\large\imprimirautor}

    \vfill
    \begin{center}
    \ABNTEXchapterfont\bfseries\LARGE\imprimirtitulo
    \end{center}
    \vfill

    \large\imprimirlocal

    \large\imprimirdata

    \vspace*{1cm}
  \end{capa}
}

% O template gera \includegraphics[width=...,height=\textheight] para as
% figuras do Markdown; sem keepaspectratio, toda imagem seria esticada até a
% altura da página. Com ele, largura e altura viram limites e a proporção é mantida.
\setkeys{Gin}{keepaspectratio}

% Blocos de código (gramática e exemplos) em corpo menor, para que as linhas
% caibam na largura do texto; e folga extra para parágrafos com código embutido.
\renewcommand{\verbatim@font}{\normalfont\ttfamily\footnotesize}
\setlength{\emergencystretch}{3em}

% Quadros (longtable) que atravessam uma quebra de página repetem a legenda e
% apareceriam duas vezes na lista de quadros. As entradas repetidas têm a mesma
% âncora do hyperref (4º argumento), então só a primeira é impressa.
\AtBeginDocument{%
  \let\cm@contentsline\contentsline
  \renewcommand{\contentsline}[4]{%
    \if\relax\detokenize{#4}\relax
      \cm@contentsline{#1}{#2}{#3}{#4}%
    \else\ifcsname cm@visto@#4\endcsname\else
      \expandafter\gdef\csname cm@visto@#4\endcsname{}%
      \cm@contentsline{#1}{#2}{#3}{#4}%
    \fi\fi}%
}
